.DS_Store
node_modules
.env
.env.*
!.env.example
.fallow
fallow.sarif
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.pnpm-store
vite.config.*.timestamp*
*.log

# Vitest coverage reports (the `test:coverage` task).
coverage/

# TypeScript incremental build cache. Regenerated; never committed.
*.tsbuildinfo
.tsbuildinfo/

# Built package output (`vp run build`); published to npm, never committed.
dist/

# Generated API reference (`vp run docgen`). Never committed; the README is
# the reference consumers read.
docs/

# The Vite+ task cache and vitest scratch dirs (browser-mode screenshots).
.vite/
.vitest/
__screenshots__/
# The generated git-hook runner; the editable hook itself is committed.
.vite-hooks/_/
