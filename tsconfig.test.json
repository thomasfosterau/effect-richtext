{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Tests import the package by name, as a consumer would; the mapping
    // resolves that name to `src/` so the type gate never needs `dist/`
    // first (vite.config.ts's `resolve.alias` does the same at run time).
    // Relative to this file; TypeScript 7 removed `baseUrl`.
    "paths": {
      "effect-richtext/*": ["./src/*.ts"]
    },
    // Test code is ported from ProseMirror's suites, which leave parameters
    // and locals unused in callbacks and fixtures.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false
  },
  "include": ["src", "tests", "vite.config.ts"]
}
