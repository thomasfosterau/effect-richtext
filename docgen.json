{
  "$schema": "./node_modules/@effect/docgen/schema.json",
  "exclude": [
    "src/internal/**/*.ts",
    "src/compat/internal/**/*.ts"
  ],
  "srcLink": "https://github.com/thomasfosterau/effect-richtext/tree/main/src/",
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "module": "ES2022",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  }
}
